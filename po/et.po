#: data/appdata/re.sonny.Tangram.metainfo.xml:5 data/re.sonny.Tangram.desktop:3
msgid "Tangram"
msgstr "Tangram"

#: data/appdata/re.sonny.Tangram.metainfo.xml:6
msgid "Sonny Piers"
msgstr "Sonny Piers"

#: data/appdata/re.sonny.Tangram.metainfo.xml:10
#: data/re.sonny.Tangram.desktop:4
msgid "Browser for your pinned tabs"
msgstr "Esiletõstetud vahekaartidega brauser"

#: data/appdata/re.sonny.Tangram.metainfo.xml:13
msgid "Tangram is a new kind of browser. It is designed to organize and run your Web applications. Each tab is persistent and independent. You can set multiple tabs with different accounts for the same application."
msgstr "Tangram on uut sorti veebibrauser. Ta on mõeldud sinu kasutatavate veebirakenduste haldamiseks ja kasutamiseks. Iga vahekaart on püsiv ja teistest eraldatud. Sa saad samast rakendusest luua eri vahekaarte, mis pruugivad eri kasutajakontosid."

#: data/appdata/re.sonny.Tangram.metainfo.xml:17
msgid "Common use cases:"
msgstr "Levinud kasutusjuhtumid:"

#: data/appdata/re.sonny.Tangram.metainfo.xml:20
msgid "Stay up to date with your favorite communities; Mastodon, Twitter, ..."
msgstr "Jälgid oma lemmikkogukondade tegevust: Mastodon, Twitter, ..."

#: data/appdata/re.sonny.Tangram.metainfo.xml:22
msgid "Merge all these chat applications into one; WhatsApp, Messenger, Telegram, ..."
msgstr "Liidad kõik need vestlusrakendused üheks: WhatsApp, Messenger, Telegram, ..."

#: data/appdata/re.sonny.Tangram.metainfo.xml:24
msgid "Group your organization tools under one application; EMail, Calendar, ..."
msgstr "Rühmitad oma organisatsiooni töövahendid üheks: E-post, kalender, ..."

#: data/appdata/re.sonny.Tangram.metainfo.xml:25
msgid "One-stop for multiple sources of documentation or information"
msgstr "Ligipääs mitmest allikast pärit dokumentatsioonile, juhenditele ja teabele"

#: data/appdata/re.sonny.Tangram.metainfo.xml:43
msgid "Fix a bug preventing to start Tangram"
msgstr "Parandasime vea, mis takistas Tangrami käivitamist"

#: data/appdata/re.sonny.Tangram.metainfo.xml:44
msgid "Reduce the noisiness of logs"
msgstr "Vähendasime logide jutukust"

#: data/appdata/re.sonny.Tangram.metainfo.xml:52
msgid "Fix a bug preventing to add new tabs"
msgstr "Parandasime vea, mis takistas uute vahekaartide lisamist"

#: data/appdata/re.sonny.Tangram.metainfo.xml:60
msgid "Notifications priority is normal instead of urgent by default"
msgstr "Vaikimisi on teavituste tähtsus nüüd senise olulise asemel tavaline"

#: data/appdata/re.sonny.Tangram.metainfo.xml:61
msgid "Add a per-tab setting to change notifications priority"
msgstr "Lisasime vahekaardikohase seadistuse teavituste olulisuse määramiseks"

#: data/appdata/re.sonny.Tangram.metainfo.xml:62
msgid "Fix authentication on many popular websites"
msgstr "Parandasime autentimisvea paljudes populaarsetes veebisaitides"

#: data/appdata/re.sonny.Tangram.metainfo.xml:63
msgid "Fix Cancel button in tab settings dialog"
msgstr "Parandasime katkesta-nupu toimimise vahekaartide seadistuse vaates"

#: data/appdata/re.sonny.Tangram.metainfo.xml:64
msgid "Use middle-click or Ctrl+click to open links in the browser"
msgstr "Lisasime võimaluse linkide avamiseks välises brauseris keskmise klõpsuga või Ctrl+klõpsuga"

#: data/appdata/re.sonny.Tangram.metainfo.xml:72
msgid "Fix window title"
msgstr "Parandasime akna pealkirja vea"

#: data/appdata/re.sonny.Tangram.metainfo.xml:73
msgid "Update GNOME runtime to 41"
msgstr "Uuendasime GNOME'i käitusteegi versioonini 41"

#: data/appdata/re.sonny.Tangram.metainfo.xml:82
msgid "Fix an issue preventing some sites such as Twitter or Facebook from being added."
msgstr "Parandasime vea, mis takistas mõnede saitide nagu Twitter või Facebook lisamist."

#: data/appdata/re.sonny.Tangram.metainfo.xml:83
msgid "Update GNOME runtime to 3.38"
msgstr "Uuendasime GNOME'i käitusteegi versioonini 3.38"

#: data/appdata/re.sonny.Tangram.metainfo.xml:91
msgid "Enable spell checking"
msgstr "Võtsime kasutusele õigekirjakontrolli"

#: data/appdata/re.sonny.Tangram.metainfo.xml:92
msgid "Customizable user-agent per instance"
msgstr "Lisasime baruseritunnuse vahekaardikohase muutmise võimaluse"

#: data/appdata/re.sonny.Tangram.metainfo.xml:93
msgid "New project icon/logo"
msgstr "Projekti uus ikoon/logo"

#: data/appdata/re.sonny.Tangram.metainfo.xml:94
msgid "New tab background color respects dark mode"
msgstr "Uus taustavärv arvestab tumeda kujundusega"

#: data/appdata/re.sonny.Tangram.metainfo.xml:102
msgid "Add support for downloading files"
msgstr "Lisasime failide allalaadimise võimaluse"

#: data/appdata/re.sonny.Tangram.metainfo.xml:103
msgid "Add home button"
msgstr "Lisasime avalehe nupu"

#: data/appdata/re.sonny.Tangram.metainfo.xml:104
msgid "Better desktop integration"
msgstr "Parem lõimimine töölauakeskkonnaga"

#: data/appdata/re.sonny.Tangram.metainfo.xml:105
msgid "Fix the main window becoming tiny when unmaximizing"
msgstr "Parandasime olukorra, kus tegumiribale vähendatud aken avanes pisikesena"

#: data/appdata/re.sonny.Tangram.metainfo.xml:106
msgid "Enable touchpad/touchscreen swipe navigation gestures"
msgstr "Võtsime kasutusele saidi sees liikumise puuteplaadil ja puuteekraanil viibates"

#: data/appdata/re.sonny.Tangram.metainfo.xml:114
msgid "Better notifications handling"
msgstr "Parandasime teavituste töötlemist"

#: data/appdata/re.sonny.Tangram.metainfo.xml:115
msgid "Improved web compatibility and performances"
msgstr "Parandasime veebiga ühilduvist ja jõudlust"

#: data/appdata/re.sonny.Tangram.metainfo.xml:117
msgid "Tangram now works properly on Flatpak 1.0 (Linux Mint, Ubuntu 18.04, ...)"
msgstr "Tangram toimib nüüd korralikult Flatpak 1.0-ga (Linux Mint, Ubuntu 18.04, ...)"

#: data/re.sonny.Tangram.desktop:13
msgid "Franz;Ferdi;Rambox;Wavebox;Station;"
msgstr "Franz;Ferdi;Rambox;Wavebox;Station; Tangram;veebirakendus;veeb;sait;saidid;brauser;veebibrauser;browser;kasutajakonto;kasutajakontod;"

